{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixes"
  ],
  "properties": {
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "line_id",
          "suggested_text",
          "fits",
          "note"
        ],
        "properties": {
          "locale": {
            "type": "string"
          },
          "line_id": {
            "type": "string",
            "maxLength": 40,
            "description": "The line id from the input block, e.g. L4. At most 40 characters."
          },
          "suggested_text": {
            "type": "string",
            "maxLength": 1000,
            "description": "The corrected line in the target language. At most 1000 characters."
          },
          "fits": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "maxLength": 240,
            "description": "What you changed and why, in one or two sentences. At most 240 characters."
          }
        }
      },
      "maxItems": 60,
      "description": "One fix per line you were given, at most 60."
    }
  }
}
