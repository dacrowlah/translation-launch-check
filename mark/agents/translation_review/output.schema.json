{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locale",
    "checksum",
    "findings",
    "rule_checks"
  ],
  "properties": {
    "locale": {
      "type": "string"
    },
    "checksum": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "check",
          "severity",
          "detail",
          "evidence"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "maxLength": 40,
            "description": "The line id from the review input, e.g. L3. At most 40 characters."
          },
          "check": {
            "type": "string",
            "enum": [
              "meaning",
              "claim",
              "tone",
              "idiom",
              "untranslated"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "warning",
              "info"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 240,
            "description": "Plain English for a marketer: what changed and why it matters. At most 240 characters."
          },
          "evidence": {
            "type": "string",
            "maxLength": 120,
            "description": "Short quotes of the master and the translation. At most 120 characters."
          }
        }
      },
      "maxItems": 20,
      "description": "At most 20 findings: the most important first."
    },
    "rule_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "opinion",
          "reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "maxLength": 40,
            "description": "The listed id, e.g. R1. At most 40 characters."
          },
          "opinion": {
            "type": "string",
            "enum": [
              "real_problem",
              "same_meaning",
              "cannot_tell"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 200,
            "description": "Why, in one or two sentences. At most 200 characters."
          }
        }
      },
      "maxItems": 20,
      "description": "One per listed rule finding, at most 20."
    }
  }
}
