#!/usr/bin/env bash
# Format and lint the staged tool/ files. Enable with: git config core.hooksPath .githooks
set -eu

ROOT="$(git rev-parse --show-toplevel)"
staged=()
while IFS= read -r path; do
  staged+=("${path#tool/}")
done < <(git diff --cached --name-only --diff-filter=ACM -- 'tool/*.ts' 'tool/*.js' 'tool/*.mjs' 'tool/*.json')

[ "${#staged[@]}" -eq 0 ] && exit 0
cd "$ROOT/tool"
pnpm exec prettier --check "${staged[@]}"

code=()
for path in "${staged[@]}"; do
  case "$path" in *.ts | *.js | *.mjs) code+=("$path") ;; esac
done
[ "${#code[@]}" -eq 0 ] || pnpm exec eslint "${code[@]}"
