#!/usr/bin/env bash
# Format and lint the staged tool/, mark/ and scripts/ files. Enable with: git config core.hooksPath .githooks
set -eu

ROOT="$(git rev-parse --show-toplevel)"
staged=()
while IFS= read -r path; do
  staged+=("${path#tool/}")
done < <(git diff --cached --name-only --diff-filter=ACM -- 'tool/*.ts' 'tool/*.js' 'tool/*.mjs' 'tool/*.json')

check_tool() {
  [ "${#staged[@]}" -eq 0 ] && return 0
  cd "$ROOT/tool"
  pnpm exec prettier --check "${staged[@]}"

  code=()
  for path in "${staged[@]}"; do
    case "$path" in *.ts | *.js | *.mjs) code+=("$path") ;; esac
  done
  [ "${#code[@]}" -eq 0 ] || pnpm exec eslint "${code[@]}"
}

check_mark() {
  local py=()
  while IFS= read -r path; do py+=("$path"); done < <(
    git diff --cached --name-only --diff-filter=ACM -- 'mark/*.py' 'scripts/*.py'
  )
  [ "${#py[@]}" -eq 0 ] && return 0
  cd "$ROOT"
  .venv/bin/ruff check "${py[@]}"
  .venv/bin/ruff format --check "${py[@]}"
}

check_tool
check_mark
