{
  "schema_version": "1.3",
  "agent_type": "specialized",
  "cwd": null,
  "name": "Example Reviewer",
  "output": {
    "type": "json",
    "description": "Findings for one locale, with the locale and checksum echoed back",
    "schema": {
      "type": "object",
      "required": [
        "locale",
        "checksum",
        "findings"
      ],
      "properties": {
        "locale": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "line_id",
              "severity",
              "detail"
            ],
            "properties": {
              "line_id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "blocker",
                  "warning",
                  "info"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "version": "1.0.0",
  "agent_id": "example_reviewer",
  "roi_unit": null,
  "is_active": true,
  "roi_label": null,
  "is_deleted": false,
  "parameters": [
    {
      "name": "locale",
      "type": "string",
      "default": null,
      "required": true,
      "item_type": null,
      "max_items": null,
      "min_items": null,
      "description": "The locale under review, e.g. de-DE. Echo it back unchanged."
    },
    {
      "name": "lines",
      "type": "string",
      "default": null,
      "required": true,
      "item_type": null,
      "max_items": null,
      "min_items": null,
      "description": "One line per entry: [L1] master text => translated text"
    },
    {
      "name": "checksum",
      "type": "string",
      "default": null,
      "required": true,
      "item_type": null,
      "max_items": null,
      "min_items": null,
      "description": "Integrity token. Echo it back unchanged; never use it in the review."
    }
  ],
  "roi_amount": null,
  "description": "Reviews one locale's translated lines and returns findings with severities.",
  "llm_provider": null,
  "prompt_pills": null,
  "enabled_tools": [
    "example_check"
  ],
  "agent_metadata": {
    "enable_auto_skill_prediction": false,
    "enable_auto_skill_prediction_by_tools": true
  },
  "inference_type": "simple",
  "initial_message": null,
  "prompt_template": "{skill: `example-glossary`} \n\nReview the translated lines for [[locale]]:\n\n[[lines]]\n\nFor each line, judge whether the meaning or a claim changed and whether the tone fits. Call `example_check` on every line you flag. Return JSON matching the output schema: echo `locale` and `checksum` exactly as given ([[checksum]]). Never output a verdict.\n\n{skill: **auto-tool**}",
  "input_guardrails": null,
  "internal_version": 1,
  "conversation_mode": false,
  "first_prompt_mode": "open",
  "is_enabled_in_chat": false,
  "memory_token_limit": 100000,
  "private_executions": false,
  "evaluation_criteria": null,
  "system_prompt_template": "",
  "enable_personal_context": false,
  "enable_auto_tool_prediction": false
}
