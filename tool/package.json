{
  "name": "launch-readiness-check-tool",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@optimizely-opal/opal-tools-sdk": "0.1.41-dev",
    "eld": "2.1.1",
    "express": "4.22.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-metz": "1.0.0",
    "jscpd": "5.4.3",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:directives": "metz-check-directives .",
    "typecheck": "tsc --noEmit",
    "dup": "jscpd",
    "test": "vitest run",
    "test:gate": "vitest run --reporter=json --outputFile=.vitest.json && node scripts/check-test-report.mjs"
  }
}
